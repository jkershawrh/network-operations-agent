# Optional, internal synthetic MCP service. Never expose it through a public Route.
NETWORK_OPS_MCP_URL=

# Optional model wording. The runtime must inject all three values together.
# BASE_URL includes /v1; the client appends /chat/completions.
# Do not commit a real key or render it into Showroom.
# Choose an assigned CPU-backed model, e.g. granite-3-2-8b-instruct-cpu.
NETWORK_OPS_MODEL_BASE_URL=
NETWORK_OPS_MODEL_NAME=
NETWORK_OPS_MODEL_API_KEY=
